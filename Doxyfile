# Doxygen configuration for the Pomodoro timer.
# Build: doxygen Doxyfile      Output: docs/doxygen/html/index.html
# Documented in README.md ("Build the source documentation"); decision: BC-001, O5.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Pomodoro Timer"
PROJECT_BRIEF          = "Tkinter Pomodoro timer, Day 28 of 100 Days of Code"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Python sources: docstrings and ## comments use Doxygen commands (@brief, @param, @return)
INPUT                  = README.md src
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
AUTOLINK_SUPPORT       = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

# Diagnostics: the build must finish without warnings
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
SOURCE_BROWSER         = YES
HAVE_DOT               = NO
